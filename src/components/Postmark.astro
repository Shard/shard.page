---
// Circular date stamp, the kind a post office rolls across an envelope.
interface Props { date: Date; tilt?: number; class?: string }
const { date, tilt = -10, class: className } = Astro.props;
const day = date.toLocaleDateString('en-AU', { day: 'numeric', timeZone: 'UTC' });
const month = date.toLocaleDateString('en-AU', { month: 'short', timeZone: 'UTC' }).toUpperCase();
const year = date.getUTCFullYear();
const id = `pm-${date.getTime().toString(36)}`;
---
<svg class:list={['postmark', className]} viewBox="0 0 120 120" style={`--tilt:${tilt}deg`} role="img" aria-label={`Posted ${day} ${month} ${year}`}>
  <defs><path id={id} d="M60 60 m-43 0 a43 43 0 1 1 86 0 a43 43 0 1 1 -86 0" /></defs>
  <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="3" />
  <circle cx="60" cy="60" r="33" fill="none" stroke="currentColor" stroke-width="1.5" />
  <text class="postmark__ring"><textPath href={`#${id}`} startOffset="0" textLength="266" lengthAdjust="spacing">SHARD.PAGE · BRISBANE · AUSTRALIA ·</textPath></text>
  <text class="postmark__day" x="60" y="58" text-anchor="middle">{day} {month}</text>
  <text class="postmark__year" x="60" y="76" text-anchor="middle">{year}</text>
</svg>
